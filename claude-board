#!/usr/bin/python3 -I
"""Feed the Lightning Z screen's Claude sessions board.

  claude-board hook           Claude Code hook: reads the hook event (JSON) on stdin and records the
                              session's state. Installed in ~/.claude/settings.json.
  claude-board run            the agent (systemd user unit claude-board.service): tracks sessions,
                              their tmux position and title, and whether you have looked at them, and
                              pushes the list to the screen service once a second when it changes.
  claude-board list           print the sessions as the screen sees them
  claude-board seen [all|ID]  mark finished sessions as seen (e.g. ones in the Claude app)

States: needs (waiting for an answer, a permission or a plan approval), done (finished, not looked
at yet), working, idle (finished and seen). A finished session counts as seen when its tmux pane
is the focused pane for a second (or was already focused when it finished), when the window it runs
in (Claude app, VS Code, a terminal) has the focus for a second, or when you send it a message.
Window focus comes from the small GNOME Shell extension claude-board-focus, which writes the focused
window's pid and title to $XDG_RUNTIME_DIR/claude-board-focus.json. The screen service only ever receives the list; it never reads your files.
"""
import json, os, re, socket, subprocess, sys, time

STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "claude-board")
SOCK = os.environ.get("LIGHTNING_SCREEN_SOCKET", "/run/lightning-display/control.sock")
HOME = os.path.expanduser("~")
ASK_TOOLS = {"AskUserQuestion": "Claude is asking you a question",
             "ExitPlanMode": "Claude wants you to approve a plan"}
NEEDS_NOTES = ("permission_prompt", "elicitation_dialog")
SEEN_AFTER = 1.0          # seconds a pane must have focus to count as looked at
DONE_TTL = 8 * 3600       # a finished session nobody looked at for this long stops asking for attention
FOCUS_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "claude-board-focus.json")
TERMINALS = {"ptyxis": "ptyxis", "kitty": "kitty", "gnome-terminal-": "terminal", "konsole": "terminal",
             "alacritty": "terminal", "wezterm-gui": "terminal", "foot": "terminal", "xterm": "terminal"}
RESEND = 10               # push at least this often, so the screen knows the agent is alive
SHELLS = {"sh", "bash", "dash", "zsh", "fish"}


# ---- per-session state files --------------------------------------------------------------------
def path(sid):
    return os.path.join(STATE, re.sub(r"[^A-Za-z0-9_.-]", "_", sid) + ".json")


def load(sid):
    try:
        with open(path(sid)) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def save(s):
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    tmp = f"{path(s['id'])}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        json.dump(s, f)
    os.replace(tmp, path(s["id"]))


def remove(sid):
    try: os.unlink(path(sid))
    except OSError: pass


def all_sessions():
    out = []
    try: names = os.listdir(STATE)
    except OSError: return out
    for n in names:
        if n.endswith(".json"):
            try:
                with open(os.path.join(STATE, n)) as f:
                    out.append(json.load(f))
            except (OSError, ValueError):
                pass
    return out


# ---- hook ----------------------------------------------------------------------------------------
def claude_pid():
    """The Claude Code process that ran this hook (walks up past the shell)."""
    pid = os.getppid()
    for _ in range(6):
        try:
            exe = os.readlink(f"/proc/{pid}/exe")
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv = f.read().split(b"\0")[:2]
            with open(f"/proc/{pid}/stat") as f:
                ppid = int(f.read().rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            return None
        names = [os.path.basename(a.decode(errors="replace")) for a in argv]
        if os.path.basename(exe) not in SHELLS and ("/claude" in exe or any("claude" in n for n in names)):
            return pid
        if ppid <= 1:
            return None
        pid = ppid
    return None


def hook():
    try:
        ev = json.load(sys.stdin)
    except ValueError:
        return
    sid, name = ev.get("session_id"), ev.get("hook_event_name")
    if not sid or not name:
        return
    if name == "SessionEnd":
        return remove(sid)
    s = load(sid)
    if name == "PostToolUse" and not (s and s.get("state") == "needs"):
        return                                   # the common case: nothing to do, stay fast
    now = time.time()
    s = s or {"id": sid, "state": "idle", "since": now, "seen": True, "msg": ""}
    s["cwd"] = ev.get("cwd") or s.get("cwd") or ""
    s["transcript"] = ev.get("transcript_path") or s.get("transcript") or ""
    if os.environ.get("TMUX_PANE"):
        s["pane"] = os.environ["TMUX_PANE"]
    if os.environ.get("CLAUDE_CODE_ENTRYPOINT"):
        s["entry"] = os.environ["CLAUDE_CODE_ENTRYPOINT"]
    pid = claude_pid()
    if pid:
        s["pid"] = pid

    def to(state, seen, msg=""):
        s.update(state=state, since=now, seen=seen, msg=msg)

    tool = ev.get("tool_name")
    if name == "SessionStart":
        to("idle", True)
    elif name == "UserPromptSubmit":
        to("working", True)
    elif name == "Stop":
        to("done", False)
    elif name == "PreToolUse" and tool in ASK_TOOLS:
        to("needs", False, ASK_TOOLS[tool])
    elif name == "PostToolUse":                  # answered / permission granted: back to work
        to("working", True)
    elif name == "Notification":
        kind, msg = ev.get("notification_type") or "", ev.get("message") or ""
        if kind in NEEDS_NOTES or (not kind and "permission" in msg.lower()):
            to("needs", False, msg)
    save(s)


# ---- agent ---------------------------------------------------------------------------------------
def alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (ProcessLookupError, ValueError, TypeError):
        return False
    except PermissionError:
        return True


def tmux():
    """{pane_id: (session, window, pane, title)}, {focused pane ids}, [window layouts]"""
    def run(*args):
        try:
            return subprocess.run(["tmux", *args], capture_output=True, text=True, timeout=2).stdout
        except (OSError, subprocess.TimeoutExpired):
            return ""
    panes, wins = {}, {}
    fmt = "\t".join("#{%s}" % k for k in (
        "pane_id", "session_name", "window_index", "pane_index", "pane_title", "pane_left", "pane_top",
        "pane_width", "pane_height", "window_width", "window_height", "pane_current_command",
        "window_name", "window_active", "session_attached"))
    for line in run("list-panes", "-a", "-F", fmt).splitlines():
        p = line.split("\t")
        if len(p) != 15:
            continue
        pid, sess, win, pn, title, x, y, w, h, ww, wh, cmd, wname, wact, attached = p
        panes[pid] = (sess, win, pn, title)
        pre = "" if sess == "main" else sess + ":"
        key = (sess, win)
        if key not in wins:
            wins[key] = {"win": pre + win, "name": wname[:40], "active": wact == "1" and attached != "0",
                         "w": int(ww), "h": int(wh), "panes": []}
        wins[key]["panes"].append({"pos": f"{pre}{win}.{pn}", "id": pid, "x": int(x), "y": int(y),
                                   "w": int(w), "h": int(h), "cmd": cmd[:24]})
    focused = set()
    for line in run("list-clients", "-F", "#{client_flags}\t#{pane_id}").splitlines():
        flags, _, pane = line.partition("\t")
        if "focused" in flags.split(","):
            focused.add(pane)
    layout = []
    for key in sorted(wins, key=lambda k: (k[0] != "main", k[0], int(k[1]) if k[1].isdigit() else 0)):
        w = wins[key]
        for pn in w["panes"]:
            pn["focus"] = pn.pop("id") in focused
        layout.append(w)
    return panes, focused, layout[:8]


_titles = {}


def transcript_title(tpath):
    """The session's latest title from its transcript (read from the end; cached by size)."""
    try:
        size = os.path.getsize(tpath)
    except (OSError, TypeError):
        return ""
    hit = _titles.get(tpath)
    if hit and hit[0] == size:
        return hit[1]
    title = ""
    try:
        with open(tpath, "rb") as f:
            f.seek(max(0, size - (1 << 20)))
            for line in reversed(f.read().splitlines()):
                if b'"custom-title"' in line or b'"ai-title"' in line:
                    try:
                        j = json.loads(line)
                    except ValueError:
                        continue
                    title = j.get("customTitle") or j.get("aiTitle") or j.get("title") or ""
                    if title:
                        break
    except OSError:
        pass
    _titles[tpath] = (size, title)
    return title


def clean_title(t):
    t = re.sub(r"^[^\w(\[\"']+", "", t or "").strip()      # Claude's spinner glyph in pane titles
    return "" if t in ("", "claude", "Claude Code", socket.gethostname()) else t


_hosts = {}


def host(pid, entry):
    """(where, ancestor pids) of a Claude process: "app" (Claude desktop), "vscode" (extension or its
    terminal), "ptyxis" / "kitty" / "terminal", or "other". Cached per pid."""
    if pid in _hosts:
        return _hosts[pid]
    chain, where, q = set(), None, pid
    try:
        with open(f"/proc/{pid}/environ", "rb") as f:
            env = dict(l.split(b"=", 1) for l in f.read().split(b"\0") if b"=" in l)
    except OSError:
        env = {}
    if "desktop" in entry:
        where = "app"
    elif "vscode" in entry or env.get(b"TERM_PROGRAM") == b"vscode":
        where = "vscode"
    for _ in range(14):
        try:
            with open(f"/proc/{q}/stat") as f:
                head, tail = f.read().rsplit(")", 1)
            comm, q = head.split("(", 1)[1], int(tail.split()[1])
        except (OSError, ValueError, IndexError):
            break
        if q <= 1:
            break
        chain.add(q)
        try:
            with open(f"/proc/{q}/comm") as f:
                c = f.read().strip()
        except OSError:
            continue
        if where is None:
            if c in ("code", "code-insiders", "codium"):
                where = "vscode"
            elif c.startswith("claude-desktop"):
                where = "app"
            else:
                where = next((v for k, v in TERMINALS.items() if c.startswith(k)), None)
    _hosts[pid] = (where or "other", chain)
    return _hosts[pid]


def focus():
    """The focused window as written by the GNOME Shell extension: {"pid", "title", ...} or None."""
    try:
        with open(FOCUS_FILE) as f:
            w = json.load(f)
        return w if isinstance(w, dict) and int(w.get("pid") or 0) > 0 else None
    except (OSError, ValueError, TypeError):
        return None


def visible_outside_tmux(sessions, win):
    """Ids of the non-tmux sessions that the focused window shows."""
    fpid, title = int(win["pid"]), (win.get("title") or "").lower()
    cands = [s for s in sessions if fpid in s["_chain"]]
    if len(cands) <= 1:
        return {s["id"] for s in cands}
    by_title = {s["id"] for s in cands if s["_title"] and s["_title"].lower() in title}
    if by_title:
        return by_title
    where = cands[0]["_where"]
    if where == "vscode":                        # the window title names the open folder
        return {s["id"] for s in cands if s["_project"] and s["_project"].lower() in title}
    if where == "app":                           # one window lists them all in its sidebar
        return {s["id"] for s in cands}
    return set()                                 # terminal tabs we can't tell apart


def run():
    focus_start, last_sent, last_payload = {}, 0.0, None
    focus_key, focus_since = None, 0.0
    while True:
        now = time.time()
        panes, focused, layout = tmux()
        for p in list(focus_start):
            if p not in focused:
                del focus_start[p]
        for p in focused:
            focus_start.setdefault(p, now)

        win = focus()
        wkey = (win["pid"], win.get("title")) if win else None
        if wkey != focus_key:
            focus_key, focus_since = wkey, now

        out, outside = [], []
        for s in all_sessions():
            sid = s.get("id")
            if not sid:
                continue
            if s.get("pid") and not alive(s["pid"]):
                remove(sid)
                _hosts.pop(s["pid"], None)
                continue
            if not s.get("pid") and now - s.get("since", 0) > 86400:
                remove(sid)
                continue
            pane = s.get("pane")
            in_tmux = pane in panes
            # looked at: its pane has had focus for a second, or already had it when it finished
            if s.get("state") == "done" and not s.get("seen") and in_tmux and pane in focus_start:
                fs = focus_start[pane]
                if fs <= s.get("since", 0) or now - fs >= SEEN_AFTER:
                    s["seen"] = mark_seen(sid, s.get("since"))
            cwd = s.get("cwd") or ""
            project = "~" if cwd.rstrip("/") == HOME else os.path.basename(cwd.rstrip("/")) or cwd
            if in_tmux:
                sess, win_i, pn, ptitle = panes[pane]
                pos, where = (f"{win_i}.{pn}" if sess == "main" else f"{sess}:{win_i}.{pn}"), "tmux"
            else:
                ptitle, pos = "", ""
                where, chain = host(s["pid"], s.get("entry", "")) if s.get("pid") else ("other", set())
            title = clean_title(ptitle) or transcript_title(s.get("transcript")) or ""
            if not in_tmux:
                outside.append(dict(s, _chain=chain, _where=where, _title=title, _project=project))
            out.append({"id": sid, "title": title, "project": project, "pos": pos, "where": where,
                        "state": s.get("state", "idle"), "seen": s.get("seen"), "since": s.get("since", now),
                        "msg": s.get("msg", "")})

        # sessions outside tmux: seen when the window showing them has had the focus for a second
        if win and outside:
            shown = visible_outside_tmux(outside, win)
            for s in outside:
                if (s["id"] in shown and s.get("state") == "done" and not s.get("seen")
                        and (focus_since <= s.get("since", 0) or now - focus_since >= SEEN_AFTER)):
                    if mark_seen(s["id"], s.get("since")):
                        next(o for o in out if o["id"] == s["id"])["seen"] = True

        for o in out:
            seen = o.pop("seen")
            if o["state"] == "done" and (seen or now - o["since"] > DONE_TTL):
                o["state"] = "idle"

        out.sort(key=lambda x: x["id"])
        payload = json.dumps({"mode": "claude-status", "sessions": out, "tmux": layout})
        if payload != last_payload or now - last_sent >= RESEND:
            if send(payload):
                last_payload, last_sent = payload, now
        time.sleep(1.0)


def mark_seen(sid, since):
    """Mark as seen, unless a hook has changed the session since we read it."""
    s = load(sid)
    if not s or s.get("state") != "done" or s.get("since") != since:
        return False
    s["seen"] = True
    save(s)
    return True


def send(payload):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as c:
            c.settimeout(3)
            c.connect(SOCK)
            c.sendall(payload.encode() + b"\n")
            c.recv(4096)
        return True
    except OSError:
        return False                             # screen service not running; try again next round


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "list"
    if cmd == "hook":
        try:
            hook()
        except Exception:
            pass                                 # never get in Claude's way
    elif cmd == "run":
        run()
    elif cmd == "list":
        for s in sorted(all_sessions(), key=lambda s: s.get("since", 0)):
            state = "idle" if s.get("state") == "done" and s.get("seen") else s.get("state")
            where = "tmux" if s.get("pane") else (host(s["pid"], s.get("entry", ""))[0] if s.get("pid") else "-")
            print(f"{state:8} {where:8} {s.get('pane', '-'):5} {s.get('cwd', '')}  {s['id']}")
    elif cmd == "seen":
        which = sys.argv[2] if len(sys.argv) > 2 else "all"
        for s in all_sessions():
            if s.get("state") == "done" and which in ("all", s["id"]):
                s["seen"] = True
                save(s)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
